# SECRET_KEY JWT
SECRET_KEY=your_jwt_secret_key_here

# DB config
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=""
DB_NAME=pos_db

# Email config
EMAIL=your_email@gmail.com
APP_PASSWORD=your_email_app_password

# Stripe Secret key 
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# Bakong KHQR Configuration
BAKONG_ACCOUNT_ID=your_bakong_account_id
MERCHANT_NAME=Your Store Name
MERCHANT_CITY=Phnom Penh
MERCHANT_PHONE=85512345678
STORE_LABEL=POS Store

# Bakong Open API (for payment verification)
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=your_bakong_api_token
BAKONG_API_ENABLED=true

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Configuration (CORS & OAuth Redirection)
CLIENT_URL=http://localhost:3000
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/success
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:3000/auth/failure

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# JWT & Cookie Session Configuration
JWT_SECRET=your_dev_secret_key
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token
